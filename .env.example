# 입찰 제안서 블라인드 검증 서비스 환경설정
# 이 파일을 .env로 복사하고 값을 설정하세요: cp .env.example .env

# ── Claude API (필수: AI 판정 활성화) ─────────────────────────
# Anthropic Console에서 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude 모델 선택 (기본: claude-3-5-sonnet-20241022)
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── 파일 보안 설정 ────────────────────────────────────────────
# 업로드 파일 자동 삭제 TTL (분, 기본: 30)
AUTO_DELETE_MIN=30

# 최대 업로드 파일 크기 (MB, 기본: 100)
MAX_FILE_SIZE_MB=100

# ── OCR 설정 ─────────────────────────────────────────────────
# Tesseract OCR 활성화 여부 (기본: true)
OCR_ENABLED=true
